//! Rendering the event feed and the outcome on stderr. Presentation
//! ONLY: everything the CLI shows, the library computed. `stderr` is
//! the one sink every human line passes through, `mode` picks the
//! renderer, `plain`/`pretty` render the live feed, `summary` the final
//! report, `format` the shared number spellings.

pub(crate) mod format;
pub(crate) mod mode;
pub(crate) mod plain;
pub(crate) mod pretty;
pub(crate) mod stderr;
pub(crate) mod summary;
