[package]
name = "rdlt-connector-protocol"
description = "rdlt out-of-process connector wire protocol v1: the gRPC/protobuf contract and the stdout handshake line"
readme = "README.md"
# The wire contract was frozen 2026-08-07 and re-opened 2026-08-19 by
# the owner while the workspace is pre-release: both halves of the wire
# live here, so a change lands in both at once and the version refuses
# any peer built against the other. The publish posture is a
# SEPARATE, owner-scheduled decision and did not move with the freeze —
# this stays false until the owner schedules publication.
publish = false
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true

[dependencies]
tonic = { workspace = true }
tonic-prost = { workspace = true }
prost = { workspace = true }
thiserror = { workspace = true }

[build-dependencies]
tonic-prost-build = { workspace = true }
protoc-bin-vendored = { workspace = true }

[lints]
workspace = true
