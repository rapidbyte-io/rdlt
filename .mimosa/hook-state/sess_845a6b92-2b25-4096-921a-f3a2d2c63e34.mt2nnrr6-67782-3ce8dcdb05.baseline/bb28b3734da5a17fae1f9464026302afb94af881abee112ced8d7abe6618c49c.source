[package]
name = "rdlt-cli"
description = "rdlt CLI: run a YAML pipeline spec, stream events, report the outcome"
keywords = ["elt", "etl", "pipeline", "cli", "data"]
categories = ["command-line-utilities", "database"]
documentation = "https://docs.rs/rdlt-cli"
readme = "README.md"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true

[[bin]]
name = "rdlt"
path = "src/main.rs"

[features]
# The live run-contract pins (tests/cases/test_spawned.rs) spawn the
# built reference connector; OFF by default so a plain workspace run
# never depends on bins no workspace command builds — the Makefile's
# spawn-bins line enables it and sets RDLT_BUILD_CONNECTOR_BINS=1.
spawn-bins = []

[dependencies]
clap = { workspace = true }
console = { workspace = true }
indicatif = { workspace = true }
libc = { workspace = true }
rdlt = { workspace = true }
# The connector requirement and role the `schema` command hands the
# runtime's provider, spelled at the client crate's own paths.
rdlt-connector-client = { workspace = true }
rdlt-connector-protocol = { workspace = true }
serde_json = { workspace = true }
tokio = { workspace = true }

[lints]
workspace = true

[dev-dependencies]
# The in-memory terminal the live display's row-count pin renders into.
indicatif = { workspace = true, features = ["in_memory"] }
rdlt-testkit = { workspace = true }
tempfile = { workspace = true }
