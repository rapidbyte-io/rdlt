{"passed":false,"reports":[{"clauses":[{"id":"P-HANDSHAKE","note":null,"outcome":"passed","reason":null,"statement":"the handshake answers the protocol's major version with that version, the connector's spec and limits before any configuration, ignores features it does not know, and refuses another major version as unsupported; the configuration answers the same connector's spec"},{"id":"P-ORDER","note":null,"outcome":"passed","reason":null,"statement":"a call before the handshake or before the configuration, and a second handshake or configuration, are refused with typed errors"},{"id":"P-ROLE","note":null,"outcome":"inapplicable","reason":"the connector serves the destination role too","statement":"a role the connector does not serve is refused as unsupported"},{"id":"P-LIMITS","note":null,"outcome":"passed","reason":null,"statement":"a configuration, a source's cursor or a destination's batch frame beyond the connector's limit is refused with `limit_exceeded`"},{"id":"P-HEARTBEAT","note":null,"outcome":"passed","reason":null,"statement":"each heartbeat is answered with its sequence number, in order"},{"id":"P-MALFORMED","note":null,"outcome":"passed","reason":null,"statement":"a call the connector cannot read, or a frame it cannot decode, is refused with a typed error, and the connection serves on"},{"id":"P-CREDIT","note":null,"outcome":"passed","reason":null,"statement":"a read sends nothing more once its credit is spent, until more is granted"},{"id":"S-CHECK","note":null,"outcome":"passed","reason":null,"statement":"check succeeds exactly when a read does, and both do for a valid configuration"},{"id":"S-DISCOVER","note":null,"outcome":"passed","reason":null,"statement":"discover lists at least one stream and is stable across calls"},{"id":"S-PLAN","note":null,"outcome":"passed","reason":null,"statement":"every stream plans at least one partition, with distinct ids"},{"id":"S-RESUME","note":null,"outcome":"passed","reason":null,"statement":"a read resumed from a checkpoint yields exactly the data after it"},{"id":"S-PARTITION","note":null,"outcome":"passed","reason":null,"statement":"a stream's planned partitions cover it exactly once, and those planned again from where they stood cover what is left exactly once"},{"id":"S-STOP","note":null,"outcome":"passed","reason":null,"statement":"a read asked to stop ends promptly and cleanly, a following read of a partition that never ends too, while it waits for data"},{"id":"S-BARRIER","note":null,"outcome":"inapplicable","reason":"no stream checkpoints on demand","statement":"an on-demand stream answers a pending barrier with a checkpoint"},{"id":"S-ACK","note":null,"outcome":"inapplicable","reason":"the source does not tell where it stands","statement":"a stream's position outside the engine moves only when the engine tells it a cursor is committed, and then to that cursor"},{"id":"K-SOURCE","note":null,"outcome":"unobserved","reason":"no kill interrupted the load: it ended first (kill seed 515)","statement":"a source killed at random points of a load after it commits is started again and resumes from what was committed, so the engine converges on exactly the tables a load never killed publishes"}],"connector":"io.rapidbyte.memory","passed":false,"verdict":"incomplete"}],"verdict":"incomplete"}
