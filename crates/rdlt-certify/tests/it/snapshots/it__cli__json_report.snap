{"passed":true,"reports":[{"clauses":[{"id":"P-HANDSHAKE","outcome":"passed","reason":null,"statement":"the handshake answers the protocol's major version with the connector's spec and limits, ignores features it does not know, and refuses another major version as unsupported"},{"id":"P-ORDER","outcome":"passed","reason":null,"statement":"a call before the handshake, and a second handshake, are refused with typed errors"},{"id":"P-ROLE","outcome":"skipped","reason":"the connector serves the destination role too","statement":"a role the connector does not serve is refused as unsupported"},{"id":"P-LIMITS","outcome":"passed","reason":null,"statement":"a configuration, a source's cursor or a destination's batch frame beyond the connector's limit is refused with `limit_exceeded`"},{"id":"P-HEARTBEAT","outcome":"passed","reason":null,"statement":"each heartbeat is answered with its sequence number, in order"},{"id":"P-MALFORMED","outcome":"passed","reason":null,"statement":"a call the connector cannot read, or a frame it cannot decode, is refused with a typed error, and the connection serves on"},{"id":"P-CREDIT","outcome":"passed","reason":null,"statement":"a read sends nothing more once its credit is spent, until more is granted"},{"id":"S-CHECK","outcome":"passed","reason":null,"statement":"check succeeds exactly when a read does, and both do for a valid configuration"},{"id":"S-DISCOVER","outcome":"passed","reason":null,"statement":"discover lists at least one stream and is stable across calls"},{"id":"S-PLAN","outcome":"passed","reason":null,"statement":"every stream plans at least one partition, with distinct ids"},{"id":"S-RESUME","outcome":"passed","reason":null,"statement":"a read resumed from a checkpoint yields exactly the data after it"},{"id":"S-STOP","outcome":"passed","reason":null,"statement":"a read asked to stop ends promptly and cleanly"},{"id":"S-BARRIER","outcome":"skipped","reason":"no stream checkpoints on demand","statement":"an on-demand stream answers a pending barrier with a checkpoint"},{"id":"K-SOURCE","outcome":"skipped","reason":"no kill interrupted the load (kill seed 515): it ended first","statement":"a source killed at random points of a load after it commits is started again and resumes from what was committed, so the engine converges on exactly the tables a load never killed publishes"}],"connector":"io.rapidbyte.memory","passed":true}]}
