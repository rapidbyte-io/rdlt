     fn child_table_idx(&mut self, parent_idx: usize, source_key: &str) -> usize {
         let parent_table = self.tables[parent_idx].table.clone();
         let parent_depth = self.tables[parent_idx]
             .parent
             .as_ref()
             .map_or(0, |p| p.depth);
