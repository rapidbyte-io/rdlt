-                if i > 0 {
+                if i >= /* ~ changed by cargo-mutants ~ */ 0 {
                     out.push(b',');
                 }
                 // Key serialization via serde_json for correct escaping.
                 serde_json::to_writer(&mut *out, key).expect("string serialization");
                 out.push(b':');
