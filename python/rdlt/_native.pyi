from collections.abc import Callable, Sequence
from datetime import timedelta
from os import PathLike
from typing import Protocol, final

__all__ = ["Host", "Pipeline", "__version__"]

__version__: str

class _StreamName(Protocol):
    @property
    def name(self) -> str: ...
    @property
    def namespace(self) -> str | None: ...

class _Tls(Protocol):
    @property
    def cert(self) -> str | PathLike[str]: ...
    @property
    def key(self) -> str | PathLike[str]: ...
    @property
    def ca(self) -> str | PathLike[str]: ...

class _HostSettings(Protocol):
    @property
    def connectors(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def writable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def readable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def always_readable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def allow_network(self) -> bool: ...
    @property
    def build_wait(self) -> timedelta | None: ...
    @property
    def allow_env(self) -> Sequence[str]: ...
    @property
    def allow_files(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def secret_store(self) -> Callable[[str], str | None] | None: ...
    @property
    def remote(self) -> _Tls | None: ...
    @property
    def trust_binaries(self) -> bool: ...

@final
class Host:
    def __new__(cls, settings: _HostSettings) -> Host: ...

@final
class Pipeline:
    @staticmethod
    def build(text: str, host: Host) -> Pipeline: ...
    @staticmethod
    def build_path(path: str | PathLike[str], host: Host) -> Pipeline: ...
    def document(self) -> str: ...
    def check(self) -> None: ...
    def discover(self) -> str: ...
    def reset(self, streams: Sequence[str | _StreamName], *, tables: bool) -> str: ...
