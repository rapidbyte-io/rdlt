from collections.abc import Awaitable, Callable, Sequence
from datetime import timedelta
from os import PathLike
from typing import Protocol, final

import pyarrow as pa

__all__ = [
    "COLUMN_MISSING",
    "COMMIT_STALE",
    "CURSOR_UNISSUED",
    "HOST_CODES",
    "OP_COLUMN",
    "RETENTION_LOST",
    "SCHEMA_CONFLICT",
    "SEQ_COLUMN",
    "TABLE_OWNED",
    "UNCHANGED_COLUMN",
    "Changes",
    "Checkpoint",
    "DestinationFactory",
    "Events",
    "Host",
    "Notice",
    "Pipeline",
    "Run",
    "SourceFactory",
    "StreamContext",
    "Transform",
    "__version__",
    "certify_destination",
    "certify_source",
    "certify_transform",
    "clauses",
    "minimal_capabilities",
    "serve",
    "table_schema",
    "unreadable_capabilities",
]

__version__: str
HOST_CODES: tuple[str, ...]
COMMIT_STALE: str
TABLE_OWNED: str
SCHEMA_CONFLICT: str
COLUMN_MISSING: str
RETENTION_LOST: str
CURSOR_UNISSUED: str
OP_COLUMN: str
SEQ_COLUMN: str
UNCHANGED_COLUMN: str

class _StreamName(Protocol):
    @property
    def name(self) -> str: ...
    @property
    def namespace(self) -> str | None: ...

class _Tls(Protocol):
    @property
    def cert(self) -> str | PathLike[str]: ...
    @property
    def key(self) -> str | PathLike[str]: ...
    @property
    def ca(self) -> str | PathLike[str]: ...

class _HostSettings(Protocol):
    @property
    def connectors(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def writable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def readable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def always_readable(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def allow_network(self) -> bool: ...
    @property
    def build_wait(self) -> timedelta | None: ...
    @property
    def allow_env(self) -> Sequence[str]: ...
    @property
    def allow_files(self) -> Sequence[str | PathLike[str]]: ...
    @property
    def _weak_secret_store(self) -> Callable[[str], str | None] | None: ...
    @property
    def remote(self) -> _Tls | None: ...
    @property
    def trust_binaries(self) -> bool: ...
    @property
    def _sources(self) -> Sequence[SourceFactory]: ...
    @property
    def _destinations(self) -> Sequence[DestinationFactory]: ...
    @property
    def _native_transforms(self) -> Sequence[tuple[str, Transform]]: ...

@final
class Host:
    def __new__(cls, settings: _HostSettings, origin: Host | None = None) -> Host: ...

@final
class Pipeline:
    @staticmethod
    def build(text: str, host: Host) -> Pipeline: ...
    @staticmethod
    def build_path(path: str | PathLike[str], host: Host) -> Pipeline: ...
    def document(self) -> str: ...
    def check(self) -> None: ...
    def discover(self) -> str: ...
    def reset(self, streams: Sequence[str | _StreamName], *, tables: bool) -> str: ...
    def start(self) -> Run: ...
    def run(self) -> tuple[str, str | None]: ...

@final
class Checkpoint:
    def __new__(cls, cursor: str) -> Checkpoint: ...

@final
class Changes:
    def __new__(cls, batch: object) -> Changes: ...

@final
class StreamContext:
    def checkpoint_due(self) -> bool: ...
    @property
    def partition(self) -> str: ...
    @property
    def unbounded(self) -> bool: ...
    @property
    def follows(self) -> bool: ...
    @property
    def resumes(self) -> bool: ...
    @property
    def excluded(self) -> list[str]: ...
    @property
    def limits(self) -> list[tuple[str, int]]: ...
    def stopped(self) -> bool: ...
    def notify(self, notice: Notice) -> None: ...

@final
class Notice:
    @staticmethod
    def replan() -> Notice: ...
    @staticmethod
    def behind(records: int, bytes: int | None, time: timedelta | None) -> Notice: ...

class _Stream(Protocol):
    @property
    def spec(self) -> str: ...
    def plan(
        self,
        phase: int,
        positions: Sequence[tuple[str, bool, str | None]],
        generation: int | None,
        completed: Sequence[int],
    ) -> tuple[int | None, Sequence[tuple[str, bool]], Sequence[tuple[str, str]]]: ...
    def committed(self, cursors: Sequence[tuple[str, str | None]]) -> None: ...
    def acknowledged(self, partition: str) -> str | None: ...
    def read(self, partition: str, cursor: str | None, context: StreamContext) -> object: ...

class _Connected(Protocol):
    @property
    def streams(self) -> Sequence[_Stream]: ...
    @property
    def discovers(self) -> bool: ...
    def check(self) -> None: ...

@final
class SourceFactory:
    def __new__(
        cls,
        id: str,
        version: str,
        config_schema: str,
        acknowledges: bool,
        connect: Callable[[str, str | None], _Connected],
    ) -> SourceFactory: ...
    @property
    def id(self) -> str: ...

class _Writer(Protocol):
    def write(self, segment: int, batch: object) -> None: ...
    def flush(self) -> tuple[int, int]: ...

class _Session(Protocol):
    def apply_schema(self, change: str) -> None: ...
    def writer(self, table: str) -> _Writer: ...
    def discard_staged(self) -> None: ...
    def commit(self, meta: str) -> str: ...
    def close(self) -> None: ...

class _ConnectedDestination(Protocol):
    def capabilities(self) -> str: ...
    def check(self) -> None: ...
    def open(self, pipeline: str) -> tuple[_Session, str]: ...
    def published(self, table: str) -> list[list[object]]: ...

@final
class DestinationFactory:
    def __new__(
        cls,
        id: str,
        version: str,
        config_schema: str,
        reads_back: bool,
        connect: Callable[[str, str | None], _ConnectedDestination],
    ) -> DestinationFactory: ...
    @property
    def id(self) -> str: ...

@final
class Transform:
    def __new__(
        cls,
        name: str,
        function: Callable[[pa.RecordBatch], object],
        filters: bool,
        output: pa.Schema | None,
    ) -> Transform: ...
    @property
    def name(self) -> str: ...

@final
class Events:
    def __iter__(self) -> Events: ...
    def __next__(self) -> str: ...
    def readable(self) -> Awaitable[bool]: ...
    def take(self) -> str | None: ...

@final
class Run:
    def events(self) -> Events: ...
    def status(self) -> str: ...
    def stop(self, mode: str) -> None: ...
    def wait(self) -> tuple[str, str | None]: ...
    def cancel(self) -> None: ...
    def detach(self, host: object) -> None: ...
    def wait_async(self) -> Awaitable[tuple[str, str | None]]: ...

def serve(
    args: Sequence[str],
    source: tuple[SourceFactory, bool] | None,
    destination: tuple[DestinationFactory, bool] | None,
) -> str | None: ...
def table_schema(capsule: object) -> str: ...
def clauses(role: str) -> list[tuple[str, str]]: ...
def certify_source(
    source: SourceFactory | tuple[str, str, _Tls],
    config: str,
    launcher: str | PathLike[str] | None = None,
) -> str: ...
def certify_destination(
    destination: DestinationFactory | tuple[str, str, _Tls],
    config: str,
    launcher: str | PathLike[str] | None = None,
) -> str: ...
def certify_transform(transform: Transform, inputs: Sequence[pa.RecordBatch]) -> str: ...
def minimal_capabilities() -> str: ...
def unreadable_capabilities(answered: str) -> str | None: ...
